# TutorNet Agentic AI - Environment Configuration Template

# Redis Configuration (New for Performance Optimization)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_AUTH_TOKEN=  # Optional, leave empty if no authentication

# Cache Configuration (Performance Optimization)
CACHE_TTL=3600
REDIS_CACHE_ENABLED=true
GRAPH_CACHE_MAX_SIZE=50  
AGENT_CACHE_MAX_SIZE=100

# API Configuration
API_KEY=api-key
API_PREFIX=/foundation  # Optional API prefix

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:3001,http://localhost:8001,http://127.0.0.1:8000,http://127.0.0.1:8001

# Logging Configuration (Console-only for Kubernetes)
LOG_LEVEL=INFO
LOG_FORMAT=text  # json or text
# Enable detailed request logging
ENABLE_REQUEST_LOGGING=true
# Enable security event logging
ENABLE_SECURITY_LOGGING=true 
# Enable performance metrics logging
ENABLE_PERFORMANCE_LOGGING=true

# Langfuse Configuration (Observability)
LANGFUSE_ENABLE=true
LANGFUSE_SECRET_KEY=your-secret
LANGFUSE_PUBLIC_KEY=your-secret
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry Configuration (Metrics)
OTEL_RESOURCE_ATTRIBUTES="service.name=tutornet-agentic-ai"
OTEL_METRICS_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_PROPAGATORS=tracecontext,b3

# QWEN LLM Configuration
QWEN_OPENAI_ENABLED=true
QWEN_OPENAI_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI Configuration
# OPENAI_API_KEY=open-ai-api-key
# OPENAI_MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=your-key
OPENAI_MODEL_NAME=qwq-plus

# MCP Configuration
MCP_URL=http://127.0.0.1:8123/mcp

SERVICE_API_URL=http://127.0.0.1:8083

# Guardrails Configuration
GUARDRAILS_CONFIG_PATH=./config/guardrails

# Pydantic Parser Configuration
USE_PYDANTIC_PARSER_PROMPT=true

# Performance Optimization Settings
# These are new settings for the optimized implementation

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Background Processing
MAX_CONCURRENT_PROCESSING=50
PROCESSING_TIMEOUT=300  # 5 minutes

# Cache Cleanup Settings
CACHE_CLEANUP_INTERVAL=300  # 5 minutes
MAX_CACHE_ENTRIES=1000

# Debugging
DEBUG_MODE=false
