# TutorNet Agentic AI - Environment Configuration Template

# Cache Configuration (Performance Optimization)
CACHE_TTL=3600  # Cache time-to-live in seconds (1 hour)
GRAPH_CACHE_MAX_SIZE=50  # In-memory cache size
AGENT_CACHE_MAX_SIZE=100

# API Configuration
API_KEY=your-secure-api-key
API_PREFIX=/foundation  # Optional API prefix

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:3001

# Logging Configuration (Console-only for Kubernetes)
LOG_LEVEL=INFO
LOG_FORMAT=text  # json or text
ENABLE_REQUEST_LOGGING=true  # Enable detailed request logging
ENABLE_SECURITY_LOGGING=true  # Enable security event logging
ENABLE_PERFORMANCE_LOGGING=true  # Enable performance metrics logging

# Langfuse Configuration (Observability)
LANGFUSE_ENABLE=true
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# QWEN LLM Configuration
QWEN_OPENAI_ENABLED=true
QWEN_OPENAI_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_NAME=qwen-plus

# MCP Configuration
MCP_URL=http://127.0.0.1:5000/mcp

# Guardrails Configuration
GUARDRAILS_CONFIG_PATH=./config/guardrails

# Debugging
DEBUG_MODE=false